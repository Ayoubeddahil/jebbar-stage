# Étape 1 : Utiliser une image Node pour builder Angular
FROM node:20.19.0 AS builder

WORKDIR /app

# Configurer npm pour plus de stabilité
RUN npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 120000 \
    && npm config set fetch-timeout 300000

# Copier les fichiers nécessaires
COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps --fetch-timeout 300000

# Copier tout le projet et builder
COPY . .
RUN echo "=== Current directory contents ===" && \
    ls -la && \
    echo "=== Building frontend ===" && \
    npx nx build ecom-frontend --configuration=production --verbose && \
    echo "=== Build completed ===" && \
    echo "=== Checking build output ===" && \
    ls -la /app/dist/apps/ecom-frontend && \
    echo "=== Detailed build output ===" && \
    find /app/dist/apps/ecom-frontend -type f && \
    echo "=== Contents of index.html ===" && \
    cat /app/dist/apps/ecom-frontend/browser/index.html

# Étape 2 : Utiliser NGINX pour servir les fichiers statiques
FROM nginx:alpine

# Copier les fichiers compilés depuis le builder
COPY --from=builder /app/dist/apps/ecom-frontend/browser /usr/share/nginx/html

# Vérifier que les fichiers ont été copiés
RUN echo "=== Contents of nginx html directory ===" && \
    ls -la /usr/share/nginx/html && \
    echo "=== Contents of nginx html directory (detailed) ===" && \
    find /usr/share/nginx/html -type f

# Copier la configuration NGINX
COPY apps/ecom-frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Vérifier la configuration NGINX
RUN echo "=== NGINX Configuration ===" && \
    cat /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]